# Build-time environment variables for the desktop app.
#
# These are injected at build time by scripts/generate-build-env.mjs and baked
# into the packaged app (the main process is compiled with tsc, so it cannot read
# process.env at runtime in a packaged build).
#
# For local dev, copy this file to `.env` (gitignored) to override the dev
# fallbacks. In CI, set them as GitHub secrets and pass them to the
# "Build installer" step (see .github/workflows/build-desktop-installers.yml).

# Token that authenticates the desktop against the cache-manager Worker's
# read/sync endpoints. Must match SKILLS_MANAGER_CACHE_SYNC_TOKEN in
# apps/cache-manager/.dev.vars for `pnpm dev:test`.
SKILLS_MANAGER_CACHE_SYNC_TOKEN=gmsP0i8iXCTunM0zoiHR8mPG8U6Bt8mefYkTHPeQp1U

# Default cache-manager Worker API base URL baked into the app.
# Dev fallback is http://localhost:8787; set to the deployed Worker URL for releases.
BEST_100_DEFAULT_API_BASE=http://localhost:8787
