# Build-time environment variables for the desktop app.
#
# These are REQUIRED at build time (no hardcoded defaults). scripts/generate-build-env.mjs
# reads them and bakes them into the packaged app; if either is missing the build
# fails. The main process is compiled with tsc, so it cannot read process.env at
# runtime in a packaged build.
#
# Setup:
#   1. Copy this file to `.env` (which is gitignored).
#   2. Fill in the token below.
#   3. For CI/production, set the same two names as GitHub Actions secrets instead.

# Token authenticating the desktop against the cache-manager Worker's read/sync
# endpoints. For local dev, use the value of SKILLS_MANAGER_CACHE_SYNC_TOKEN from
# apps/cache-manager/.dev.vars (the same value the local Worker expects).
SKILLS_MANAGER_CACHE_SYNC_TOKEN=

# Default cache-manager Worker API base URL baked into the app. For local dev this
# is the wrangler dev address printed by `pnpm dev:cache` (http://localhost:8787).
BEST_100_DEFAULT_API_BASE=http://localhost:8787
