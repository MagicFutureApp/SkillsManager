{
  "name": "@skills-manager/desktop",
  "productName": "Skills Manager",
  "desktopName": "skills-manager.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron React TypeScript SQLite based Skills Manager App.",
  "author": "yimity",
  "homepage": "https://github.com/yimity/SkillsManager",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "pnpm run build:main && concurrently -k \"pnpm run dev:renderer\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:3700 electron .\"",
    "dev:renderer": "vite",
    "electron:version": "electron --version",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "format": "prettier --write package.json tsconfig.json tsconfig.main.json tsconfig.renderer.json vite.config.ts vitest.config.ts drizzle.config.ts components.json src",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.main.json tsconfig.renderer.json vite.config.ts vitest.config.ts drizzle.config.ts components.json src"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "41.7.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-router": "^1.170.8",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.0",
    "lucide-react": "^1.16.0",
    "minimatch": "^10.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "shadcn": "^4.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  }
}
