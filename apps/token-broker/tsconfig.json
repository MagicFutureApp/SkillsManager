{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts"]
}
